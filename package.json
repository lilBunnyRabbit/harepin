{
  "name": "harepin",
  "version": "0.38.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "check:svelte": "bun tools/svelte-check/node_modules/svelte-check/bin/svelte-check --tsconfig tools/svelte-check/tsconfig.json --fail-on-warnings",
    "preview": "vite preview",
    "telemetry": "bun scripts/telemetry.ts",
    "test": "bun test --timeout 30000",
    "test:full": "FULL=1 bun test --timeout 30000",
    "pwa-assets": "pwa-assets-generator"
  },
  "dependencies": {
    "three": "^0.187.0",
    "trystero": "^0.26.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "@vite-pwa/assets-generator": "^2.0.0",
    "playwright": "1.65.0",
    "svelte": "5.57.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
